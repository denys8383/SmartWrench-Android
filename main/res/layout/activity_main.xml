<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartWrench AI Діагностика"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/cbFakeMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Використовувати Fake Repository (без сервера)"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etDtcCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введіть код (напр. P0300)"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etMileage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Пробіг (км, 0 - 2 000 000)"
            android:inputType="number"
            android:layout_marginBottom="12dp"/>

        <!-- Нова ознака 1: Вибір типу двигуна -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип двигуна:"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spEngineType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <!-- Нова ознака 2: Додатковий контекст (симптоми авто) -->
        <EditText
            android:id="@+id/etSymptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Симптоми (напр. троїть, дим, глохне — необов'язково)"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Запитати в AI-механіка"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Повторити останній запит"
            android:backgroundTint="#FF9800"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#B00020"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистити всю історію"
            android:backgroundTint="#B00020"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
